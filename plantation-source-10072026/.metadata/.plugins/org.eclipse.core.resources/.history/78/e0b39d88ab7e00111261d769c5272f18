spring:
  application:
    name: mcd-plantation-portal

  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:plantation}
    username: ${DB_USER:postgres}
    password: ${DB_PASSWORD:postgres}
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000

  jpa:
    hibernate:
      ddl-auto: none
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        format_sql: false
        jdbc:
          batch_size: 25
        order_inserts: true
        order_updates: true
    open-in-view: false

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

  mail:
    host: ${MAIL_HOST:smtp.gmail.com}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USER:noreply@mcd.gov.in}
    password: ${MAIL_PASS:}
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true

  cache:
    type: simple

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

server:
  port: ${PORT:8080}
  servlet:
    context-path: /plantation
  compression:
    enabled: true
    mime-types: application/json,application/xml,text/html

jwt:
  signKey: B90AF1C2N73B9N4399N8909N6AA11E3B3D280B8C1F69N6AF8N44ECNA010N0B1C86D77D3A
  encryptdecryptkey: 62F85FA18AFC707D2F409A1FF59888112BD1DBB77626E5D47B9E0A7B4EBD9F7F

razorpay:
  key-id: ${RAZORPAY_KEY_ID:rzp_test_placeholder}
  key-secret: ${RAZORPAY_KEY_SECRET:placeholder_secret}
  currency: INR
  gst-rate: 0.18
  processing-fee: 50.00
  dev-mode: ${RAZORPAY_DEV_MODE:true}

storage:
  #upload-dir: ${UPLOAD_DIR:E:/Mcd Projects/upload}
  upload-dir: ${UPLOAD_DIR:E:/kaushik}
  base-url: ${STORAGE_BASE_URL:http://localhost:8080/plantation/uploads}

mcd:
  certificate:
    issuer: "Municipal Corporation of Delhi"
    department: "Horticulture Department"
    city: "New Delhi"
  booking:
    cancellation-hours: 48
    payment-expiry-minutes: 30
  inventory:
    low-stock-threshold: 3

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    operations-sorter: alpha
    tags-sorter: alpha
  info:
    title: MCD Green Plantation Portal API
    version: 2.0.0
    description: REST API for MCD Green Plantation Portal with slot-level tree inventory

logging:
  level:
    com.mcd.plantation: DEBUG
    org.springframework.security: INFO
    org.hibernate.SQL: INFO
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
    
rolecode:
  plantation:
    admin: R_HORTIC_ADM
    horticultre-admin: R_HORTIC_OFF
    supervisor: SUPERVISOR
  
  
  
